{
  "name": "dsh-model-live",
  "version": "0.3.3",
  "description": "模型调用实时监视：包装 llm/stream 瀑布，实时展示每次模型调用的模型、耗时、首字延迟、token 与速率，并汇总模型相关元数据（上下文窗口、模态、推理档位）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client/index.js",
    "client/build.mjs",
    "client/dist",
    "cordis.patch.yml",
    "README.md",
    "test"
  ],
  "scripts": {
    "build": "node client/build.mjs",
    "pack": "npm pack"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "llm",
    "model",
    "monitor",
    "模型",
    "实时"
  ],
  "license": "MIT"
}
