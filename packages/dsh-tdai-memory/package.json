{
  "name": "dsh-tdai-memory",
  "version": "1.0.0",
  "description": "TencentDB Agent Memory 桥接：注入长期记忆使用指引、注册 L1/L0/画像检索工具、每轮对话结束自动归档到本机 Memory Gateway",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "tencentdb"
  ],
  "license": "MIT"
}
